<resources>
    <style name="Theme.TrailsActions" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/surface_900</item>
        <item name="android:navigationBarColor">@color/surface_900</item>
        <item name="android:statusBarColor">@color/surface_900</item>
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/info_500</item>
    </style>

    <style name="Widget.TrailsActions.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/brand_500</item>
        <item name="android:textColor">@color/black</item>
        <item name="rippleColor">@color/brand_700</item>
    </style>

    <style name="Widget.TrailsActions.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="strokeColor">@color/border_300</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/slate_900</item>
        <item name="backgroundTint">@color/surface_700</item>
        <item name="rippleColor">@color/border_300</item>
    </style>

    <style name="Widget.TrailsActions.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/surface_900</item>
        <item name="boxStrokeColor">@color/border_300</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="colorControlNormal">@color/slate_500</item>
        <item name="colorControlActivated">@color/brand_500</item>
        <item name="hintTextColor">@color/slate_500</item>
        <item name="android:textColorHint">@color/slate_500</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TrailsActions.Field</item>
    </style>

    <style name="ShapeAppearance.TrailsActions.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
</resources>
